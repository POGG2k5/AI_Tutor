MODEL_PATH=./models/checkpoint-30
BASE_MODEL_PATH=./models/Qwen3-8B-unsloth-bnb-4bit
MAX_SEQ_LEN=4096
LOAD_IN_4BIT=true
DEVICE=auto
LOG_LEVEL=INFO

# Lan chay dau tren may moi: tu dong tai model con thieu ve ./models.
AUTO_DOWNLOAD=true
# Repo Hugging Face chua LoRA adapter (uu tien hon Kaggle). Vi du: xuandinh030705/nckh-math-qwen3-8b-lora
# ADAPTER_REPO=
# Repo base model tren Hugging Face; bo trong de dung base_model_name_or_path trong adapter_config.json.
# BASE_MODEL_REPO=unsloth/Qwen3-8B-unsloth-bnb-4bit
# Model Kaggle dung khi khong dat ADAPTER_REPO (model public, khong can dang nhap).
# KAGGLE_ADAPTER=aegold/math-nckh/transformers/default
# Chi can thiet voi repo private/gated.
# HF_TOKEN=
